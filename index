<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Доска изображений в серых тонах</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: #1a1a1a;
            font-family: 'Segoe UI', Arial, sans-serif;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 1200px;
        }

        h1 {
            color: #fff;
            text-align: center;
            margin-bottom: 25px;
            font-weight: 300;
            letter-spacing: 3px;
            font-size: 28px;
            text-transform: uppercase;
            opacity: 0.8;
        }

        .board {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            grid-template-rows: auto auto;
            gap: 12px;
            background: #2a2a2a;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 8px 40px rgba(0, 0, 0, 0.8);
        }

        .board-item {
            position: relative;
            background: #1e1e1e;
            border-radius: 10px;
            overflow: hidden;
            aspect-ratio: 1 / 1;
            display: flex;
            justify-content: center;
            align-items: center;
            border: 2px solid #3a3a3a;
            transition: border-color 0.3s ease, transform 0.3s ease;
        }

        .board-item:hover {
            border-color: #666;
            transform: scale(1.02);
            z-index: 2;
        }

        .board-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(100%);
            transition: filter 0.4s ease;
        }

        .board-item img:hover {
            filter: grayscale(0%);
        }

        .board-item .label {
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.8);
            color: #ccc;
            padding: 4px 14px;
            border-radius: 6px;
            font-size: 11px;
            white-space: nowrap;
            pointer-events: none;
            letter-spacing: 0.5px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .board-item .badge {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(255, 255, 255, 0.1);
            color: #888;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 10px;
            pointer-events: none;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .board-item .badge.user {
            background: rgba(76, 175, 80, 0.3);
            color: #8bc34a;
            border-color: rgba(76, 175, 80, 0.2);
        }

        .board-item .badge.template {
            background: rgba(255, 193, 7, 0.15);
            color: #ffd54f;
            border-color: rgba(255, 193, 7, 0.1);
        }

        .controls {
            margin-top: 20px;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .controls button {
            padding: 10px 28px;
            border: none;
            border-radius: 8px;
            background: #3a3a3a;
            color: #aaa;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s ease;
            letter-spacing: 0.5px;
            border: 1px solid transparent;
        }

        .controls button:hover {
            background: #4a4a4a;
            color: #fff;
        }

        .controls button.active {
            background: #555;
            color: #fff;
            border-color: #777;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.05);
        }

        .info {
            color: #666;
            text-align: center;
            margin-top: 15px;
            font-size: 13px;
            letter-spacing: 0.5px;
        }

        .info span {
            color: #888;
        }

        /* Адаптив */
        @media (max-width: 768px) {
            .board {
                grid-template-columns: repeat(3, 1fr);
                gap: 8px;
                padding: 12px;
            }
            
            .board-item .label {
                font-size: 9px;
                padding: 2px 10px;
                bottom: 4px;
            }
            
            .board-item .badge {
                font-size: 8px;
                padding: 1px 8px;
                top: 4px;
                right: 4px;
            }
            
            h1 {
                font-size: 20px;
            }
        }

        @media (max-width: 480px) {
            .board {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>

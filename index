                <span class="badge template">◇ Шаблон</span>
            </div>

            <!-- 5. Шаблон 3 -->
            <div class="board-item" data-index="4">
                <img src="" alt="Шаблон 3" 
                     onerror="this.style.display='none'">
                <div class="template-placeholder" style="
                    width: 100%;
                    height: 100%;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    align-items: center;
                    background: linear-gradient(135deg, #1e1e1e 0%, #2d1b1b 100%);
                    color: #555;
                    font-size: 14px;
                    text-align: center;
                    padding: 20px;
                ">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#644" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <path d="M3 9L9 3"/>
                        <path d="M21 15L15 21"/>
                    </svg>
                    <span style="margin-top: 10px; font-size: 12px; color: #644;">Шаблон C</span>
                </div>
                <span class="label">Шаблон C</span>
                <span class="badge template">◇ Шаблон</span>
            </div>

            <!-- Ряд 2: ещё 5 изображений (снова 2 ваших + 3 шаблона, но других) -->
            <!-- 6. Ваше первое (повтор) -->
            <div class="board-item" data-index="5">
                <img src="image 152.png" alt="image 152.png" 
                     onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22300%22%3E%3Crect fill=%22%23222%22 width=%22300%22 height=%22300%22/%3E%3Ctext x=%2250%%22 y=%2250%%22 text-anchor=%22middle%22 dy=%22.3em%22 fill=%22%23555%22 font-family=%22Arial%22 font-size=%2218%22%3Eimage 152.png%3C/text%3E%3C/svg%3E'">
                <span class="label">image 152.png</span>
                <span class="badge user">● Пользователь</span>
            </div>

            <!-- 7. Ваше второе (повтор) -->
            <div class="board-item" data-index="6">
                <img src="image 152 (1).png" alt="image 152 (1).png" 
                     onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22300%22%3E%3Crect fill=%22%23222%22 width=%22300%22 height=%22300%22/%3E%3Ctext x=%2250%%22 y=%2250%%22 text-anchor=%22middle%22 dy=%22.3em%22 fill=%22%23555%22 font-family=%22Arial%22 font-size=%2218%22%3Eimage 152 (1).png%3C/text%3E%3C/svg%3E'">
                <span class="label">image 152 (1).png</span>
                <span class="badge user">● Пользователь</span>

        <div class="controls">
            <button class="active" onclick="setFilter('grayscale')">🔘 Серый</button>
            <button onclick="setFilter('none')">🎨 Цветной</button>
            <button onclick="toggleTemplates()">👁 Скрыть шаблоны</button>
        </div>

        <div class="info">
            <span>●</span> Пользовательские: <span id="userCount">2</span> &nbsp;|&nbsp; 
            <span>◇</span> Шаблоны: <span id="templateCount">8</span> &nbsp;|&nbsp; 
            Всего: <span id="totalCount">10</span>
        </div>
    </div>

    <script>
        // ============================================================
        // Переключение серого/цветного режима
        // ============================================================
        function setFilter(mode) {
            const imgs = document.querySelectorAll('.board-item img');
            const btns = document.querySelectorAll('.controls button');
            
            btns.forEach(btn => btn.classList.remove('active'));
            
            if (mode === 'grayscale') {
                imgs.forEach(img => {
                    if (img.style.display !== 'none') {
                        img.style.filter = 'grayscale(100%)';
                    }
                });
                btns[0].classList.add('active');
            } else {
                imgs.forEach(img => {
                    if (img.style.display !== 'none') {
                        img.style.filter = 'grayscale(0%)';
                    }
                });
                btns[1].classList.add('active');
            }
        }

        // ============================================================
        // Скрыть/показать шаблоны
        // ============================================================
        let templatesVisible = true;

        function toggleTemplates() {
            const items = document.querySelectorAll('.board-item');
            const btn = document.querySelectorAll('.controls button')[2];
            
            templatesVisible = !templatesVisible;
            
            items.forEach((item, index) => {
                // Индексы 0,1,5,6 — пользовательские (первые два и их повторы)
                const isUser = (index === 0 || index === 1 || index === 5 || index === 6);
                
                if (!isUser) {
                    item.style.display = templatesVisible ? 'flex' : 'none';
                }
            });
            
            btn.textContent = templatesVisible ? '👁 Скрыть шаблоны' : '👁 Показать шаблоны';
            updateCounts();
        }

        // ============================================================
        // Обновление счётчиков
        // ============================================================
        function updateCounts() {
            const items = document.querySelectorAll('.board-item');
            let userCount = 0;
            let templateCount = 0;
            
            items.forEach(item => {
                if (item.style.display !== 'none') {
                    if (item.querySelector('.badge.user')) {
                        userCount++;
                    } else {
                        templateCount++;
                    }
                }
            });
            
            document.getElementById('userCount').textContent = userCount;
            document.getElementById('templateCount').textContent = templateCount;
            document.getElementById('totalCount').textContent = userCount + templateCount;
        }

        // ============================================================
        // Инициализация
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            // Применяем серый фильтр ко всем видимым изображениям
            const imgs = document.querySelectorAll('.board-item img');
            imgs.forEach(img => {
                if (img.style.display !== 'none') {
                    img.style.filter = 'grayscale(100%)';
                }
            });
            
            updateCounts();
        });

        // ============================================================
        // Обработка ошибок для изображений
        // ============================================================
        document.querySelectorAll('.board-item img').forEach(img => {
            img.addEventListener('error', function() {
                // Если изображение не загрузилось, показываем плейсхолдер
                const parent = this.closest('.board-item');
                const placeholder = parent.querySelector('.template-placeholder');
                if (placeholder) {
                    this.style.display = 'none';
                    placeholder.style.display = 'flex';
                }
            });
        });
    </script>
</body>
</html>
